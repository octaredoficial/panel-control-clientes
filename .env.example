# ============================================================
# Panel de Control de Clientes - Variables de entorno (plantilla)
# ------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores reales:
#     cp .env.example .env
#
# El archivo `.env` real esta en .gitignore: NUNCA lo subas al repo.
# docker-compose.yml lo carga con `env_file`.
# ============================================================

# Contrasena unica de acceso a la app. CAMBIALA por una fuerte.
APP_PASSWORD=change-me

# Secreto para firmar los tokens de sesion (HMAC-SHA256). Debe ser largo
# y aleatorio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# o, si no tienes node a mano:
#   openssl rand -hex 32
SESSION_SECRET=generate-a-long-random-string

# Ruta del archivo SQLite DENTRO del contenedor (es el volumen 'pcc-data').
DB_PATH=/data/pcc.sqlite

# Puerto interno del backend (lo proxya Caddy; no se publica al host).
PORT=8080
