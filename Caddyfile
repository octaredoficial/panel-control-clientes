# ============================================================
# Panel de Control de Clientes - Reverse proxy Caddy (HTTPS autofirmado)
# ------------------------------------------------------------
# Acceso SOLO por IP publica (64.177.92.121), sin dominio y sin Let's
# Encrypt (ACME necesita un nombre DNS verificable). Caddy termina TLS con
# un certificado AUTOFIRMADO generado por su CA interna.
#
# CLAVE (por que fallaba el handshake por IP): un cliente que se conecta por
# IP no envia SNI (o envia la IP como SNI). Con un sitio nombrado por IP
# (https://64.177.92.121) Caddy no encontraba una politica/certificado TLS
# por defecto para ese handshake sin SNI y abortaba con "internal_error".
#
# SOLUCION: combinar el option global `local_certs` con un sitio por PUERTO
# (:443). `local_certs` fuerza a que la CA interna sea el emisor por defecto
# de TODO (nunca ACME) y garantiza un certificado interno por defecto que
# presentar cuando no hay SNI. Un sitio `:443` (solo puerto) no exige
# coincidencia de host, asi que la conexion por IP sin SNI encaja en el y
# recibe el cert autofirmado interno. Eso resuelve el internal_error al
# acceder por 64.177.92.121. Se mantiene `tls internal` en el sitio de forma
# explicita (redundante con local_certs, pero claro).
#
# El navegador avisara UNA vez de que el certificado no es de confianza;
# el usuario acepta la advertencia (decision ya tomada en MIGRATION.md).
#
# Caddy proxya HTTP y WebSocket al backend Node (servicio `app:8080` en
# la red interna de docker compose). reverse_proxy reenvia de forma nativa
# el upgrade de WebSocket de /ws, asi que la sync en vivo funciona sobre
# wss:// sin configuracion extra.
#
# El backend NO se publica al host: solo Caddy expone 80/443. El :80
# redirige a :443 para que http:// caiga en https://.
# ============================================================

{
	# Sin dominio: forzar que TODO use la CA interna (cert autofirmado),
	# nunca ACME. local_certs hace que el issuer interno sea el predeterminado
	# y asegura un certificado interno por defecto disponible para presentar
	# cuando la conexion llega sin SNI (caso tipico al entrar por IP).
	local_certs
	# Solo desactivamos la redireccion HTTP->HTTPS automatica de Caddy, porque
	# ya definimos el redir del :80 de forma explicita y no queremos que ambas
	# compitan. (NO usar auto_https off: eso desactivaria toda la gestion TLS.)
	auto_https disable_redirects
}

# Sitio por PUERTO (:443) para atender cualquier conexion entrante, incluida
# la que llega por la IP publica 64.177.92.121 sin SNI. Con local_certs,
# Caddy sirve el cert autofirmado interno como predeterminado, resolviendo el
# internal_error del handshake que ocurria con un sitio nombrado por IP.
:443 {
	# Certificado autofirmado por la CA interna de Caddy (explicito).
	tls internal

	# Cabeceras de seguridad (ademas de las que ya fija el backend).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# HSTS desactivado a proposito: con cert autofirmado por IP no aporta
		# y puede complicar la aceptacion manual del certificado.
		-Server
	}

	# Proxy a backend + WebSocket (/ws se reenvia con upgrade automatico).
	reverse_proxy app:8080

	# Logs al stdout del contenedor (visibles con docker compose logs proxy).
	log {
		output stdout
		format console
	}
}

# Redirige http://IP -> https://IP (puerto 80 -> 443).
:80 {
	redir https://{host}{uri} permanent
}
